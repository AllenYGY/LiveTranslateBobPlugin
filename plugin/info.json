{
  "identifier": "com.allenygy.live.translate",
  "version": "2.3.1",
  "appcast": "https://raw.githubusercontent.com/AllenYGY/LiveTranslateBobPlugin/main/appcast.json",
  "category": "translate",
  "name": "Live Translate",
  "summary": "English speech to Chinese live captions in Bob. Type live to start; stop to stop.",
  "author": "Allen YGY",
  "minBobVersion": "1.21.0",
  "options": [
    {
      "identifier": "deepgram_api_key",
      "type": "text",
      "title": "Deepgram API Key (live speech)",
      "textConfig": { "type": "secure", "placeholderText": "课堂实时语音识别所需" }
    },
    {
      "identifier": "translation_backend",
      "type": "menu",
      "title": "Live translation engine",
      "defaultValue": "apple",
      "menuValues": [
        { "title": "Apple System Translate (default)", "value": "apple" },
        { "title": "Volcengine", "value": "volcengine" }
      ]
    },
    {
      "identifier": "access_key_id",
      "type": "text",
      "title": "Volcengine Access Key ID",
      "textConfig": { "type": "secure", "placeholderText": "填写火山引擎 Access Key ID" }
    },
    {
      "identifier": "secret_access_key",
      "type": "text",
      "title": "Volcengine Secret Access Key",
      "textConfig": { "type": "secure", "placeholderText": "填写火山引擎 Secret Access Key" }
    }
  ]
}
